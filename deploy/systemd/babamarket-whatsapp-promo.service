[Unit]
Description=Baba Market - Promotion WhatsApp Quotidienne (Statut 24h + Groupes, persistance max 2h)
After=network.target babamarket.service baba-whatsapp.service

[Service]
Type=oneshot
User=moctar
Group=moctar
WorkingDirectory=/home/moctar/baba-marketplace/dealnova
EnvironmentFile=-/etc/babamarket.env
Environment="FLASK_APP=run.py"
ExecStart=/home/moctar/baba-marketplace/venv/bin/flask whatsapp-promo run --scheduled
TimeoutStartSec=7200
StandardOutput=journal
StandardError=journal
